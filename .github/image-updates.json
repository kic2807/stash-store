{
  "_comment": "Rules for .github/scripts/update_images.py. 'tag': regex for image tags, named group 'v' = upstream version (X.Y or X.Y.Z), other named groups = build numbers. 'notes': where upstream release notes live (github owner/repo or gitea host/owner/repo, optional 'tag' regex for release tags); an update is auto-merged unless those notes mention a breaking change. 'always_review': bump kinds that always get a PR. 'automerge': bump kinds merged when no release notes are available. 'primary': the image whose version becomes the app version; other images only bump the -N packaging revision.",
  "images": {
    "favonia/cloudflare-ddns": {
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "notes": { "github": "favonia/cloudflare-ddns" },
      "automerge": ["minor", "patch"]
    },
    "gitea/runner": {
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "notes": { "gitea": "gitea.com/gitea/runner" },
      "automerge": ["minor", "patch"]
    },
    "docker": {
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)-dind$",
      "notes": { "github": "moby/moby", "tag": "^docker-v(?P<v>\\d+\\.\\d+\\.\\d+)$" },
      "automerge": ["minor", "patch"]
    },
    "lscr.io/linuxserver/qbittorrent": {
      "lookup": "ghcr.io/linuxserver/qbittorrent",
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)_v(?P<lt1>\\d+)\\.(?P<lt2>\\d+)\\.(?P<lt3>\\d+)-ls(?P<ls>\\d+)$",
      "notes": { "github": "qbittorrent/qBittorrent", "tag": "^release-(?P<v>\\d+\\.\\d+\\.\\d+)$" },
      "automerge": ["patch", "build"]
    },
    "docker@cli": {
      "_comment": "docker:<ver>-cli, used by watchdog services; same releases as dind.",
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)-cli$",
      "notes": { "github": "moby/moby", "tag": "^docker-v(?P<v>\\d+\\.\\d+\\.\\d+)$" },
      "automerge": ["minor", "patch"]
    },
    "tailscale/tailscale": {
      "_comment": "GitHub release notes only link to tailscale.com/changelog, so the semver fallback applies.",
      "tag": "^v(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "even_minor": true,
      "automerge": ["minor", "patch"]
    },
    "registry.k8s.io/pause": {
      "tag": "^(?P<v>\\d+\\.\\d+(?:\\.\\d+)?)$",
      "automerge": ["major", "minor", "patch"]
    },
    "aaronleopold/stump@nightly": {
      "_comment": "Stump is pinned to the moving 'nightly' tag: the digest is followed and the version becomes nightly-<UTC time found>.",
      "moving": "nightly",
      "automerge": ["build"]
    },
    "aaronleopold/stump": {
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "notes": { "github": "stumpapp/stump" },
      "automerge": ["patch"]
    },
    "pocketid/pocket-id": {
      "_comment": "Major releases have migration guides (pocket-id.org/docs/setup/major-releases).",
      "tag": "^v(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "notes": { "github": "pocket-id/pocket-id" },
      "always_review": ["major"],
      "automerge": ["minor", "patch"]
    },
    "ghcr.io/tinyauthapp/tinyauth": {
      "_comment": "Major releases have breaking-update guides (tinyauth.app/docs/breaking-updates).",
      "tag": "^v(?P<v>\\d+\\.\\d+\\.\\d+)$",
      "notes": { "github": "tinyauthapp/tinyauth" },
      "always_review": ["major"],
      "automerge": ["patch"]
    },
    "ghcr.io/kic2807/caddy-cloudflare": {
      "_comment": "Built by .github/workflows/build-caddy.yml. Tag <caddy>-cf<caddy-dns/cloudflare>; a plugin-only change is a 'build' bump. Caddy flags breaking changes in its release notes.",
      "tag": "^(?P<v>\\d+\\.\\d+\\.\\d+)-cf(?P<cf1>\\d+)\\.(?P<cf2>\\d+)\\.(?P<cf3>\\d+)$",
      "notes": { "github": "caddyserver/caddy" },
      "always_review": ["major"],
      "automerge": ["patch", "build"]
    }
  },
  "apps": {
    "things-cloudflare-ddns": { "primary": "favonia/cloudflare-ddns" },
    "things-gitea-act-runner": { "primary": "gitea/runner" },
    "things-qbittorrent": { "primary": "lscr.io/linuxserver/qbittorrent" },
    "things-stump": { "primary": "aaronleopold/stump" },
    "things-caddy": { "primary": "ghcr.io/kic2807/caddy-cloudflare" },
    "things-pocket-id": { "primary": "pocketid/pocket-id" },
    "things-tinyauth": { "primary": "ghcr.io/tinyauthapp/tinyauth" },
    "things-transmission-vpn": { "primary": "tailscale/tailscale" }
  }
}
