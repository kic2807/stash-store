# Optional. Copy to ~/umbrel/app-data/stash-stump/data/.env (chmod 600) to log in
# through Authelia (OIDC). Leave the file out to use Stump's own accounts only.
STUMP_OIDC_ENABLED=true
STUMP_OIDC_ISSUER_URL=https://auth.example.com
STUMP_OIDC_CLIENT_ID=stump
STUMP_OIDC_CLIENT_SECRET=
# Create Stump accounts automatically on first OIDC login
STUMP_OIDC_ALLOW_REGISTRATION=true
