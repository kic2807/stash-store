# Copy to ~/umbrel/app-data/things-cloudflare-ddns/data/.env (chmod 600) and fill in.
# Cloudflare API token with Zone:DNS:Edit on the zone(s) below.
CLOUDFLARE_API_TOKEN=
# Comma-separated hostnames to keep updated, e.g. example.com,*.example.com
DOMAINS=
# Which of them go through Cloudflare's proxy (orange cloud). A boolean or a
# per-host expression, e.g. is(id.example.com). Unset = false (all DNS only).
# Only applies when a record is created; change existing ones in the dashboard.
PROXIED=
