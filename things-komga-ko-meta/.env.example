# Copy to ~/umbrel/app-data/things-komga-ko-meta/data/.env (chmod 600) and fill in,
# then restart the app.

# API key of a Komga ADMIN account (Komga → Account settings → API keys).
# Editing metadata and uploading thumbnails needs the admin role.
KOMGA_API_KEY=

# Optional: free key from themoviedb.org. Adds 16:9 textless backdrops as a
# wide-art source.
TMDB_API_KEY=

# Optional options for the background watcher, space separated:
#   --rename-title     make the Korean title the main Komga title
#                      (default: keep yours, add the Korean one as alternate title "ko")
#   --overwrite        replace existing values (locked fields are never touched)
#   --lock             lock the fields it writes
#   --no-art           metadata only, no artwork
#   --textless-poster  use a 2:3 crop of the textless art as the cover
#   --max-characters N (default 20)
#   --interval M       minutes between full passes (default 360)
KOMGA_KO_META_FLAGS=
