# Copy to ~/umbrel/app-data/stash-tinyauth/data/.env (chmod 600) and fill in.
# The address Tinyauth is opened at, with the same :30443 port as the private
# hosts: Tinyauth only sends you back to an address whose port matches this one
# (stash-tinyauth README). Its session cookie covers example.com and subdomains.
TINYAUTH_APPURL=https://login.example.com:30443
# From the "Tinyauth" OIDC client in Pocket ID (stash-pocket-id README).
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=
# Browser-facing Pocket ID and Tinyauth addresses
TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://id.example.com/authorize
TINYAUTH_OAUTH_PROVIDERS_POCKETID_REDIRECTURL=https://login.example.com:30443/api/oauth/callback/pocketid
