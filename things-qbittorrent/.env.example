# Copy to ~/umbrel/app-data/things-qbittorrent/data/.env (chmod 600) and fill in.
# Tailscale auth key (admin console -> Settings -> Keys). Only used for the first login.
TS_AUTHKEY=
# Exit node tailnet IP (100.x.y.z). --reset keeps restarts working if flags change.
TS_EXTRA_ARGS=--exit-node=<EXIT_NODE_IP> --exit-node-allow-lan-access=true --reset
