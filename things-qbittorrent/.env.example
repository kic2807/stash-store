# Copy to ~/umbrel/app-data/things-qbittorrent/data/.env (chmod 600) and fill in.
# Tailscale auth key (admin console -> Settings -> Keys). Only used for the first login.
TS_AUTHKEY=
# Exit node by MagicDNS name, e.g. jp-tyo-wg-001.mullvad.ts.net (the base name
# or a 100.x.y.z address also work). Set after Tailscale connects, on every start.
EXIT_NODE=
