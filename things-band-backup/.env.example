# Copy to ~/umbrel/app-data/things-band-backup/data/.env (chmod 600) and fill in.
# Same list as .env.example in github.com/kic2807/band-backup.

# ── Band ─────────────────────────────────────────────
# Comma-separated "band_no:album_name" (the older "band_key:band_no:album_name" form still works)
BANDS=
# Drives the Playwright auto-login that keeps band_session fresh
BAND_PHONE=
BAND_PASSWORD=
# Max downloads per KST day (BAND's quotas are unpublished); 0 = no limit
DAILY_PHOTO_LIMIT=1000
DAILY_VIDEO_LIMIT=100

# ── Immich backup ────────────────────────────────────
IMMICH_URL=
IMMICH_API_KEY=

# ── Discord ──────────────────────────────────────────
# Outgoing webhook for 2FA prompts, errors and the daily summary
DISCORD_WEBHOOK=
# Bot that turns photos of calendars into events.
# Requires the Message Content intent in the Discord developer portal.
DISCORD_BOT_TOKEN=
EVENT_BAND_NO=
# Comma-separated; empty means every channel the bot can see
EVENT_CHANNEL_IDS=
EVENT_ANNOUNCE=false
# Read photos with Claude instead of Tesseract, on your Claude.ai plan.
# Run `claude setup-token` anywhere you're logged in and paste the token.
# Empty = Tesseract OCR.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=sonnet

# ── Google Calendar mirror ───────────────────────────
# The key file lives in the /data volume. Share the calendar with the
# service account's client_email, granting "Make changes to events".
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=/data/google-service-account.json
GOOGLE_TIME_ZONE=Asia/Seoul
