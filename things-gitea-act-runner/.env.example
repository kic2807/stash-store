# Copy to ~/umbrel/app-data/things-gitea-act-runner/data/.env (chmod 600) and fill in.
# Gitea base URL, e.g. https://code.example.com
GITEA_INSTANCE_URL=
# Gitea -> Site Administration (or Org/Repo settings) -> Actions -> Runners -> Create new runner
GITEA_RUNNER_REGISTRATION_TOKEN=
# Optional: override default labels, e.g. ubuntu-latest:docker://node:20-bookworm
GITEA_RUNNER_LABELS=
