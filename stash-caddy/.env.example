# Copy to ~/umbrel/app-data/stash-caddy/data/.env (chmod 600) and fill in.
# Cloudflare API token with Zone:Zone:Read and Zone:DNS:Edit on your zone
# (used only for the ACME DNS challenge).
CLOUDFLARE_API_TOKEN=
# Let's Encrypt account email
ACME_EMAIL=
# Your LAN subnet, e.g. 192.168.1.0/24. Used by the (private) snippet; leave
# it empty and private hosts are reachable from Tailscale only.
LAN_CIDR=
